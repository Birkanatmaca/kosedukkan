; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Köşe Dükkan"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameState="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"
Saves="*res://scripts/save_system.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1


[rendering]

renderer/rendering_method="mobile"
; Emülatörün sanal Vulkan sürücüsü görüntü aktaramıyor; emülatör sürümü OpenGL ES ile çizer.
renderer/rendering_method.emulator="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
